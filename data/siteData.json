  "reviews": [
    {
      "author": "Γιώργος Καραγιάννης",
      "rating": 5,
      "text": "Από τα λίγα μαγαζιά που συνδυάζουν πραγματικό fine dining με live σκηνή. Ο ήχος είναι πεντακάθαρος και το VIP service στο τραπέζι άψογο."
    },
    {
      "author": "Ελένη Παπαδοπούλου",
      "rating": 5,
      "text": "Εκπληκτική εμπειρία! Το φαγητό ξεπέρασε κάθε προσδοκία μας για live club, ειδικά τα steaks και τα signature cocktails. Σίγουρα θα ξαναέρθουμε."
    },
    {
      "author": "Δημήτρης Βασιλείου",
      "rating": 4,
      "text": "Εκρηκτική ενέργεια και απίστευτο stage setup. Παρότι το μαγαζί ήταν sold out, η εξυπηρέτηση της κράτησής μας ήταν ταχύτατη."
    },
    {
      "author": "Χριστίνα Μάνου",
      "rating": 5,
      "text": "Κάναμε την κράτηση online μέσα σε 1 λεπτό και όλα ήταν έτοιμα στην ώρα τους. Ο φωτισμός και η ατμόσφαιρα του χώρου είναι άλλου επιπέδου."
    },
    {
      "author": "Νίκος Αλεξίου",
      "rating": 5,
      "text": "Premium εμπειρία από την υποδοχή μέχρι το κλείσιμο του προγράμματος. Το concept φαγητό + show είναι ακριβώς αυτό που έλειπε από τη Θεσσαλονίκη."
    },
    {
      "author": "Σοφία Κωνσταντινίδη",
      "rating": 4,
      "text": "Πολύ προσεγμένο μενού κρασιών και premium ποτών. Η ορατότητα στη σκηνή από τα διαζώματα είναι εξαιρετική."
    }
  ]
